{
  "name": "pengui-slides",
  "version": "0.1.0",
  "description": "Pengui Slides MCP Server - HTML-first presentation generation with Design Soul constraint system",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "pengui-slides": "./build/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --watch src/index.ts",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "presentations",
    "slides",
    "pptx",
    "design-system"
  ],
  "author": "hurtener",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cheerio": "^1.0.0",
    "playwright": "^1.50.0",
    "postcss": "^8.5.0",
    "postcss-value-parser": "^4.2.0",
    "pptxgenjs": "^3.12.0",
    "uuid": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
