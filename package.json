{
  "name": "pengui-slides",
  "version": "0.1.0",
  "description": "Pengui Slides MCP Server - HTML-first presentation generation with Design Soul constraint system",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "pengui-slides": "./build/index.js"
  },
  "scripts": {
    "build": "npm run build:app && npm run build:server",
    "build:server": "tsc -p tsconfig.json",
    "build:app": "vite build --config vite.app.config.ts",
    "dev": "tsx --watch src/index.ts",
    "start": "node build/index.js",
    "start:http": "node build/index.js --transport http",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "presentations",
    "slides",
    "pptx",
    "design-system"
  ],
  "author": "hurtener",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.1.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "playwright": "^1.50.0",
    "postcss": "^8.5.0",
    "postcss-value-parser": "^4.2.0",
    "pptxgenjs": "^3.12.0",
    "uuid": "^11.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^28.1.0",
    "svelte": "^5.53.7",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
